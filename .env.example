# Only the data refresh script reads this (npm run refresh-data), on your machine.
# The app itself needs no key.
#
# Never name it VITE_OPENAI_API_KEY or anything starting with VITE_: Vite copies
# those into the browser bundle, where anyone can read them.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. The refresh script's model; it needs the Responses API and web search.
# OPENAI_MODEL=gpt-6.1-sol
